@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject AppState State
@inject CurrentActor CurrentActor
@inject ILibraryService Library
@inject IJSRuntime JS
@inject NavigationManager Navigation

<CascadingValue Value="State" IsFixed="true">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="app-shell">
        <aside id="library-navigation" class="sidebar" aria-label="Main navigation" onkeydown="if(event.key==='Escape') library.closeNavigation(true)">
            <a href="/" class="brand" aria-label="BookBridge home"><span class="brand-mark" aria-hidden="true">B<span>↗</span></span><span class="brand-copy"><span class="brand-name">BookBridge</span><span class="brand-sub">Library Lending &amp; Reservations</span></span></a>
            <p class="nav-caption">YOUR LIBRARY</p>
            <nav onclick="library.closeNavigation(false)">
                <NavLink href="/" Match="NavLinkMatch.All"><span aria-hidden="true">◫</span> Overview</NavLink>
                <NavLink href="/books"><span aria-hidden="true">▤</span> Book catalogue</NavLink>
                <NavLink href="/loans"><span aria-hidden="true">↗</span> @(actor?.IsLibrarian == true ? "Loans & returns" : "My loans")</NavLink>
                <NavLink href="/reservations"><span aria-hidden="true">◷</span> Reservations</NavLink>
                @if (actor?.IsLibrarian == true)
                {
                    <NavLink href="/members"><span aria-hidden="true">♧</span> Members</NavLink>
                    <NavLink href="/overdue"><span aria-hidden="true">!</span> Overdue loans</NavLink>
                }
                <NavLink href="/notifications"><span aria-hidden="true">◇</span> Notifications @if (State.Notifications.Any(n => !n.IsRead)) { <span class="nav-count">@State.Notifications.Count(n => !n.IsRead)</span> }</NavLink>
                <NavLink href="/profile"><span aria-hidden="true">◎</span> My profile</NavLink>
            </nav>
            <div class="sidebar-bottom"><p>A good book deserves<br />another reader.</p><span>Thoughtfully organised. Always in reach.</span></div>
        </aside>
        <div class="workspace">
            <header class="topbar">
                <button class="icon-button mobile-toggle" aria-label="Toggle navigation" aria-controls="library-navigation" aria-expanded="false" onclick="library.toggleNavigation(this)">☰</button>
                <span class="topbar-breadcrumb">BookBridge <span>/</span> @(actor?.IsLibrarian == true ? "Librarian" : "Member")</span>
                <div class="topbar-actions">
                    <button class="icon-button theme-toggle" aria-label="Toggle light or dark theme" onclick="library.toggleTheme()">◐</button>
                    @if (!string.IsNullOrEmpty(actor?.UserId))
                    {
                        <span class="live-status @(State.LiveConnected ? "online" : "offline")" role="status" title="@(State.LiveConnected ? "Reservation notifications arrive automatically." : "Live notifications are reconnecting. Saved notifications remain available on the Notifications page.")"><i aria-hidden="true"></i>@(State.LiveConnected ? "Live" : "Reconnecting")</span>
                        <a class="account-role" href="/profile" aria-label="Open my profile"><span class="avatar" aria-hidden="true">@(actor.IsLibrarian ? "L" : "M")</span>@(actor.IsLibrarian ? "Librarian" : "Member")</a>
                        <a class="text-button account-password-link" href="/account/password" data-enhance-nav="false">Change password</a>
                        <form method="post" action="/account/logout"><AntiforgeryToken /><button type="submit" class="text-button">Sign out</button></form>
                    }
                    else { <a href="/account/login" class="button small primary">Sign in</a> }
                </div>
            </header>
            <main id="main-content" class="main-content" tabindex="-1">
                <ErrorBoundary @ref="errorBoundary">
                    <ChildContent>@Body</ChildContent>
                    <ErrorContent><section class="empty-state" role="alert"><h1>We couldn’t finish that request</h1><p>Please reload the page and try again. Your saved library records are safe.</p><button class="button primary" @onclick="Reload">Reload page</button></section></ErrorContent>
                </ErrorBoundary>
            </main>
            <footer class="page-footer"><span>BookBridge</span><span>Library Lending &amp; Reservations</span></footer>
        </div>
    </div>
    <ToastNotification />
    <div id="blazor-error-ui" role="alert">Connection interrupted. <a href="" class="reload">Reload</a><button class="dismiss" aria-label="Dismiss">×</button></div>
</CascadingValue>

@code {
    private Actor? actor;
    private ErrorBoundary? errorBoundary;
    private DotNetObjectReference<MainLayout>? reference;
    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnStateChanged;
        Navigation.LocationChanged += OnLocationChanged;
        actor = await CurrentActor.GetAsync();
        State.SetActor(actor);
        if (!string.IsNullOrEmpty(actor.UserId)) await RefreshNotifications();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || string.IsNullOrEmpty(actor?.UserId)) return;
        reference = DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("library.connect", reference); } catch (JSDisconnectedException) { }
    }
    [JSInvokable] public async Task LibraryChanged() { await RefreshNotifications(); State.Invalidate(); }
    [JSInvokable] public void NotificationConnectionChanged(bool online) => State.SetLiveConnected(online);
    private async Task RefreshNotifications() { if (actor is not null) State.SetNotifications(await Library.GetNotificationsAsync(actor)); }
    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);
    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) { errorBoundary?.Recover(); }
    private async Task ToggleTheme() => State.DarkMode = await JS.InvokeAsync<bool>("library.toggleTheme");
    private void Reload() => Navigation.NavigateTo(Navigation.Uri, true);
    public async ValueTask DisposeAsync()
    {
        State.Changed -= OnStateChanged;
        Navigation.LocationChanged -= OnLocationChanged;
        if (reference is not null) { try { await JS.InvokeVoidAsync("library.disconnect"); } catch (JSDisconnectedException) { } }
        reference?.Dispose();
    }
}
