@inherits LayoutComponentBase
@implements IAsyncDisposable
@using Microsoft.Extensions.DependencyInjection
@inject AppState State
@inject CurrentActor CurrentActor
@inject ILibraryService Library
@inject IServiceScopeFactory ScopeFactory
@inject IJSRuntime JS
@inject NavigationManager Navigation

<CascadingValue Value="State" IsFixed="true">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="app-shell">
        <header class="app-header">
            <div class="header-inner">
                <button type="button" class="icon-button mobile-toggle" aria-label="Toggle navigation" aria-controls="library-navigation" aria-expanded="false" onclick="library.toggleNavigation(this)"><Icon Name="menu" /></button>
                <a href="/" class="brand" aria-label="BookBridge home"><BrandMark /><span class="brand-copy"><span class="brand-name">BookBridge</span><span class="brand-sub">Library Lending &amp; Reservations</span></span></a>
                <nav id="library-navigation" class="primary-nav" aria-label="Main navigation" onkeydown="if(event.key==='Escape') library.closeNavigation(true)" onclick="if(event.target.closest('a')) library.closeNavigation(false)">
                    <NavLink href="/" Match="NavLinkMatch.All"><Icon Name="home" /><span>@(actor?.IsLibrarian == true ? "Dashboard" : "Home")</span></NavLink>
                    <NavLink href="/books"><Icon Name="book" /><span>Books</span></NavLink>
                    <a href="/loans" class="@(IsLendingRoute ? "active" : null)" aria-current="@(IsLendingRoute ? "page" : null)"><Icon Name="shelf" /><span>@(actor?.IsLibrarian == true ? "Lending desk" : "My Shelf")</span></a>
                    @if (actor?.IsLibrarian == true)
                    {
                        <NavLink href="/members"><Icon Name="members" /><span>Members</span></NavLink>
                        <NavLink href="/overdue"><Icon Name="report" /><span>Reports</span></NavLink>
                    }
                    else
                    {
                        <NavLink href="/profile"><Icon Name="user" /><span>Profile</span></NavLink>
                    }
                </nav>
                <div class="header-actions">
                    <button type="button" class="icon-button theme-toggle" aria-label="Toggle light or dark theme" title="Toggle light or dark theme" onclick="library.toggleTheme()"><span class="theme-icon-light"><Icon Name="moon" /></span><span class="theme-icon-dark"><Icon Name="sun" /></span></button>
                    @if (!string.IsNullOrEmpty(actor?.UserId))
                    {
                        <a class="icon-button notification-link" href="/notifications" aria-label="Notifications" title="Notifications"><Icon Name="bell" />@if (UnreadCount > 0) { <span class="notification-count" aria-hidden="true">@UnreadCount</span><span class="visually-hidden">@UnreadCount unread</span> }</a>
                        <a class="account-link" href="/profile" aria-label="Open my profile"><span class="avatar" aria-hidden="true">@AccountInitials</span><span class="account-name">@AccountName</span></a>
                        <form class="signout-form" method="post" action="/account/logout" data-enhance="false"><AntiforgeryToken /><button type="submit" class="text-button signout-button" aria-label="Sign out" title="Sign out"><Icon Name="logout" /><span class="signout-label">Sign out</span></button></form>
                    }
                    else
                    {
                        <a href="/account/login" class="button small primary">Sign in</a>
                    }
                </div>
            </div>
        </header>
        <div class="workspace">
            <main id="main-content" class="main-content" tabindex="-1">
                <ErrorBoundary @ref="errorBoundary">
                    <ChildContent>@Body</ChildContent>
                    <ErrorContent><section class="empty-state" role="alert"><h1>We couldn’t finish that request</h1><p>Please reload the page and try again. Your saved library records are safe.</p><button class="button primary" @onclick="Reload">Reload page</button></section></ErrorContent>
                </ErrorBoundary>
            </main>
            <footer class="page-footer"><span>BookBridge <span class="footer-divider">·</span> Library Lending &amp; Reservations</span>@if (!string.IsNullOrEmpty(actor?.UserId)) { <span class="live-status @(State.LiveConnected ? "online" : "offline")" role="status" title="@(State.LiveConnected ? "Reservation notifications arrive automatically." : "Live notifications are reconnecting. Saved notifications remain available on the Notifications page.")"><i aria-hidden="true"></i>@(State.LiveConnected ? "Live updates connected" : "Reconnecting live updates")</span> }</footer>
        </div>
    </div>
    <ToastNotification />
    <div id="blazor-error-ui" role="alert">Connection interrupted. <a href="" class="reload">Reload</a><button class="dismiss" aria-label="Dismiss">×</button></div>
</CascadingValue>

@code {
    private Actor? actor;
    private AccountProfileDto? profile;
    private ErrorBoundary? errorBoundary;
    private DotNetObjectReference<MainLayout>? reference;
    private int UnreadCount => State.Notifications.Count(notification => !notification.IsRead);
    private string AccountName => profile?.Name ?? (actor?.IsLibrarian == true ? "Librarian" : "Member");
    private string AccountInitials => string.Concat(AccountName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => char.ToUpperInvariant(part[0])));
    private bool IsLendingRoute => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/') is "loans" or "reservations";

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnStateChanged;
        Navigation.LocationChanged += OnLocationChanged;
        actor = await CurrentActor.GetAsync();
        State.SetActor(actor);
        if (!string.IsNullOrEmpty(actor.UserId))
        {
            await RefreshNotifications();
            await RefreshProfile();
        }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || string.IsNullOrEmpty(actor?.UserId)) return;
        reference = DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("library.connect", reference); } catch (JSDisconnectedException) { }
    }
    [JSInvokable] public async Task LibraryChanged() { await RefreshNotifications(); await RefreshProfile(); State.Invalidate(); }
    [JSInvokable] public void NotificationConnectionChanged(bool online) => State.SetLiveConnected(online);
    private async Task RefreshNotifications() { if (actor is not null) State.SetNotifications(await Library.GetNotificationsAsync(actor)); }
    private async Task RefreshProfile()
    {
        if (actor is null) return;
        await using var scope = ScopeFactory.CreateAsyncScope();
        profile = await scope.ServiceProvider.GetRequiredService<IProfileService>().GetOwnAsync(actor);
    }
    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);
    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) { errorBoundary?.Recover(); _ = InvokeAsync(StateHasChanged); }
    private void Reload() => Navigation.NavigateTo(Navigation.Uri, true);
    public async ValueTask DisposeAsync()
    {
        State.Changed -= OnStateChanged;
        Navigation.LocationChanged -= OnLocationChanged;
        if (reference is not null) { try { await JS.InvokeVoidAsync("library.disconnect"); } catch (JSDisconnectedException) { } }
        reference?.Dispose();
    }
}
