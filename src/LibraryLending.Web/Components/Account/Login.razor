@page "/account/login"
@attribute [AllowAnonymous]
@inject IWebHostEnvironment HostEnvironment
<PageTitle>Sign in · BookBridge</PageTitle>
<div class="login-wrap">
    <section class="login-story"><span class="eyebrow">WELCOME TO BOOKBRIDGE</span><h1>Your next chapter<br />starts here.</h1><p>Discover the collection, keep track of your loans, and reserve the books you’re looking forward to.</p><div class="book-stack" aria-hidden="true"><span>THE ART OF READING</span><span>A WORLD OF IDEAS</span><span>ONE MORE CHAPTER</span></div></section>
    <section class="panel login-panel"><span class="eyebrow">BookBridge</span><h2>Welcome back</h2><p class="muted">Library Lending &amp; Reservations</p>
        @if (!string.IsNullOrWhiteSpace(Error)) { <div class="message error" role="alert">@Error</div> }
        @if (HostEnvironment.IsEnvironment("Demo"))
        {
            <p class="message">Public demo: accounts are shared and data may reset. Use sample information only.</p>
        }
        <form method="post" action="/account/sign-in" data-enhance="false">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@(ReturnUrl ?? "/")" />
            <label for="email">Email</label><input id="email" name="email" type="email" required autocomplete="username" placeholder="you@example.com" />
            <label for="password">Password</label><input id="password" name="password" type="password" required autocomplete="current-password" />
            <button type="submit" class="button primary full-width">Sign in</button>
        </form>
        <p class="login-help">Ask your librarian if you need an account or help signing in.</p>
    </section>
</div>
@code {
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
}
