@page "/account/password"
@attribute [Authorize]
<PageTitle>Change password · BookBridge</PageTitle>
<div class="page-heading"><div><span class="eyebrow">YOUR ACCOUNT</span><h1>Change your password.</h1><p>Choose a unique password that you don’t use for other accounts.</p></div></div>
<section class="panel password-panel">
    @if (!string.IsNullOrWhiteSpace(Error)) { <div class="message error" role="alert">@Error</div> }
    @if (!string.IsNullOrWhiteSpace(Success)) { <div class="message success" role="status">Your password has been changed.</div> }
    <form method="post" action="/account/change-password" data-enhance="false">
        <AntiforgeryToken />
        <div class="field"><label for="current-password">Current password</label><input id="current-password" name="currentPassword" type="password" required autocomplete="current-password" /></div>
        <div class="field"><label for="new-password">New password</label><input id="new-password" name="newPassword" type="password" required minlength="10" autocomplete="new-password" /><small>Use at least 10 characters, including uppercase and lowercase letters, a number, and a symbol.</small></div>
        <div class="field"><label for="confirm-password">Confirm new password</label><input id="confirm-password" name="confirmPassword" type="password" required minlength="10" autocomplete="new-password" /></div>
        <div class="button-row"><a class="button secondary" href="/" data-enhance-nav="false">Back to library</a><button type="submit" class="button primary">Change password</button></div>
    </form>
</section>
@code {
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "success")] public string? Success { get; set; }
}
