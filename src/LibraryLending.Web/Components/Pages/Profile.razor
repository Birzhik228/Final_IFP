@page "/profile"
@attribute [Authorize]
@inherits LibraryPageBase
@inject IProfileService Profiles
<PageTitle>My profile · BookBridge</PageTitle>

<div class="page-heading"><div><span class="eyebrow">YOUR PLACE IN THE LIBRARY</span><h1>Your profile.</h1><p>Your account details and library membership, together in one place.</p></div></div>
@if (Loading)
{
    <LoadingPanel />
}
else if (LoadError is not null)
{
    <p class="message error" role="alert">@LoadError</p>
}
else if (profile is null)
{
    <section class="empty-state"><h2>Profile unavailable</h2><p>Sign in again to view your profile. Contact your librarian if you need help with your account.</p><a class="button primary" href="/account/login" data-enhance-nav="false">Sign in</a></section>
}
else
{
    <section class="panel profile-summary" aria-label="Account summary">
        <span class="profile-avatar" aria-hidden="true">@Initials(profile.Name)</span>
        <div><span class="eyebrow">@profile.Role</span><h2>@profile.Name</h2><p>@profile.Email</p></div>
        <a class="button secondary" href="/account/password" data-enhance-nav="false">Change password</a>
    </section>
    <div class="profile-grid">
        <section class="panel" aria-labelledby="profile-personal-heading">
            <div class="section-heading"><h2 id="profile-personal-heading">Personal details</h2></div>
            <dl class="profile-details">
                <div><dt>Full name</dt><dd>@profile.Name</dd></div>
                <div><dt>Email</dt><dd>@profile.Email</dd></div>
                <div><dt>Phone</dt><dd>@(string.IsNullOrWhiteSpace(profile.Phone) ? "Not provided" : profile.Phone)</dd></div>
                <div><dt>Account role</dt><dd>@profile.Role</dd></div>
            </dl>
            <p class="page-note">Ask your librarian to update your personal details.</p>
        </section>
        @if (profile.MemberId is int memberId)
        {
            <section class="panel" aria-labelledby="profile-membership-heading">
                <div class="section-heading"><h2 id="profile-membership-heading">Your membership</h2></div>
                <dl class="profile-details">
                    <div><dt>Member ID</dt><dd>#@memberId.ToString("D4")</dd></div>
                    <div><dt>Member since</dt><dd>@(profile.JoinedAtUtc?.ToString("dd MMMM yyyy", System.Globalization.CultureInfo.InvariantCulture) ?? "Not recorded")</dd></div>
                    <div><dt>Membership status</dt><dd><StatusBadge Status="@(profile.Status?.ToString() ?? "Unknown")" /></dd></div>
                    <div><dt>Borrowing limit</dt><dd>@profile.BorrowingLimit books</dd></div>
                    <div><dt>Active loans</dt><dd>@profile.ActiveLoans</dd></div>
                    <div><dt>Available to borrow</dt><dd>@profile.RemainingLoans more books</dd></div>
                </dl>
                <p class="page-note">Borrowing also requires an active membership and no overdue loans.</p>
                <div class="button-row"><a class="button secondary" href="/loans">View my loans</a><a class="text-link" href="/reservations">My reservations →</a></div>
            </section>
        }
        else
        {
            <section class="panel" aria-labelledby="profile-library-heading"><div class="section-heading"><h2 id="profile-library-heading">Your library access</h2></div><p>You manage the catalogue, member records, loans, returns, and reservation pickups.</p><div class="button-row"><a class="button secondary" href="/members">Manage members</a><a class="text-link" href="/loans">Loans &amp; returns →</a></div></section>
        }
    </div>
}

@code {
    private AccountProfileDto? profile;
    protected override async Task LoadAsync() => profile = await Profiles.GetOwnAsync(User);
    private static string Initials(string name) => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => part[0]));
}
