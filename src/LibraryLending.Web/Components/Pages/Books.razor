@page "/books"
@attribute [Authorize]
@inherits LibraryPageBase
<PageTitle>Book catalogue · BookBridge</PageTitle>
<BookSearchBar Categories="categories" Query="query" TotalCount="books.TotalCount" OnSearch="Search"><Actions>@if (User.IsLibrarian) { <button type="button" class="button secondary catalogue-add-book" @onclick="() => showEditor = !showEditor">+ Add book</button> }</Actions></BookSearchBar>
@if (showEditor) { <BookEditor OnSave="SaveBook" OnCancel="() => showEditor = false" Busy="Busy" /> }
@if (Loading) { <LoadingPanel Message="Finding your next read…" /> }
else if (LoadError is not null) { <p class="message error" role="alert">@LoadError</p> }
else
{
    @if (books.Items.Count == 0) { <section class="empty-state"><h2>No books found</h2><p>Try another title, author, or category.</p><button class="button secondary" @onclick="() => Search(new BookQuery())">Clear filters</button></section> }
    <div class="book-grid">@foreach (var book in books.Items) { <BookCard Book="book" CanRequest="@(!User.IsLibrarian && User.MemberId.HasValue)" @key="book.Id" /> }</div>
    <div class="catalogue-note"><span class="catalogue-note-icon" aria-hidden="true"><Icon Name="info" /></span><p>Request an available book for librarian approval. Join the waiting list when all copies are unavailable.</p></div>
    <Pagination Page="books.Page" TotalPages="books.TotalPages" TotalCount="books.TotalCount" PageChanged="ChangePage" />
}
@code {
    private BookQuery query = new();
    private PageResult<BookDto> books = new([], 0, 1, 12);
    private IReadOnlyList<string> categories = [];
    private bool showEditor;
    protected override async Task LoadAsync()
    {
        categories = await Library.GetCategoriesAsync();
        var key = $"books:{query}";
        if (!State.TryGet<PageResult<BookDto>>(key, out var cached)) { books = await Library.SearchBooksAsync(query); State.Cache(key, books); } else books = cached!;
    }
    private async Task Search(BookQuery value) { query = value; Loading = true; await ReloadAsync(); }
    private async Task ChangePage(int page) { query = query with { Page = page }; await ReloadAsync(); }
    private async Task SaveBook(BookInput input) { if (await RunCommand(() => Library.SaveBookAsync(User, null, input), "Book added to the collection.")) showEditor = false; }
}
