@page "/"
@attribute [Authorize]
@inherits LibraryPageBase
<PageTitle>Overview · BookBridge</PageTitle>
<div class="page-heading"><div><span class="eyebrow">THE LIBRARY AT A GLANCE</span><h1>@(User.IsLibrarian ? "A library in motion." : "Your reading, organised.")</h1><p>@(User.IsLibrarian ? "Keep the collection flowing and every reader connected." : "Your next great read is waiting. Here’s where you left off.")</p></div><a class="button primary" href="/books">Browse collection <span aria-hidden="true">↗</span></a></div>
@if (Loading) { <LoadingPanel /> }
else if (LoadError is not null) { <p class="message error" role="alert">@LoadError</p> }
else if (User.IsLibrarian && dashboard is not null)
{
    <section class="panel request-summary"><div><h2>Borrow requests</h2><p>@PendingRequestCount @(PendingRequestCount == 1 ? "request is" : "requests are") waiting for your decision.</p></div><a class="button primary" href="/requests">Review requests</a></section>
    <div class="stats-grid"><article class="stat-card"><span class="stat-icon" aria-hidden="true">▤</span><span class="stat-label">Books in collection</span><strong>@dashboard.Books</strong><small>@dashboard.AvailableCopies copies ready to borrow</small></article><article class="stat-card"><span class="stat-icon" aria-hidden="true">↗</span><span class="stat-label">Active loans</span><strong>@dashboard.ActiveLoans</strong><small>Stories out in the world</small></article><article class="stat-card warning"><span class="stat-icon" aria-hidden="true">!</span><span class="stat-label">Overdue loans</span><strong>@dashboard.OverdueLoans</strong><a href="/overdue">Review overdue loans →</a></article><article class="stat-card"><span class="stat-icon" aria-hidden="true">◷</span><span class="stat-label">Waiting reservations</span><strong>@dashboard.WaitingReservations</strong><a href="/reservations">Manage the queue →</a></article></div>
    <div class="dashboard-grid"><section class="panel"><div class="section-heading"><div><span class="eyebrow">READER FAVOURITES</span><h2>Most borrowed books</h2></div><span class="subtle-tag">All time</span></div><div class="bar-chart" role="img" aria-label="Most borrowed books chart">@foreach (var book in dashboard.PopularBooks.Take(6)) { <div class="chart-row"><div><span>@book.Title</span><strong>@book.BorrowCount</strong></div><div class="bar-track"><span style="width:@BarWidth(book.BorrowCount)%"></span></div></div> } @if (dashboard.PopularBooks.Count == 0) { <p class="muted">Borrowing activity will appear here.</p> }</div></section><section class="panel feature-panel"><span class="eyebrow">A FAIRER WAY TO BORROW</span><h2>Every reader<br />gets their turn.</h2><p>Returned copies go straight to the next person in the reservation queue. A three-day pickup window keeps things moving.</p><a class="button secondary" href="/reservations">View reservations →</a><div class="queue-illustration" aria-hidden="true"><span>01</span><i></i><span>02</span><i></i><span>03</span></div></section></div>
    <section class="panel"><div class="section-heading"><div><span class="eyebrow">CIRCULATION DESK</span><h2>Loans to keep an eye on</h2></div><a href="/loans" class="text-link">View all loans →</a></div><LoanTable Loans="loans.Take(5).ToList()" ShowMembers="true" /></section>
}
else
{
    <section class="panel request-summary"><div><h2>Your borrow requests</h2><p>@PendingRequestCount @(PendingRequestCount == 1 ? "request is" : "requests are") waiting for librarian approval. See decisions and issued copies in your request history.</p></div><a class="button secondary" href="/requests">View requests</a></section>
    <div class="stats-grid member-stats"><article class="stat-card"><span class="stat-label">Your active loans</span><strong>@loans.Count(l => l.ReturnedAtUtc is null)</strong><a href="/loans">View your loans →</a></article><article class="stat-card warning"><span class="stat-label">Overdue</span><strong>@loans.Count(l => l.ReturnedAtUtc is null && l.DaysOverdue > 0)</strong><small>Return these to borrow again</small></article><article class="stat-card"><span class="stat-label">Ready to collect</span><strong>@reservations.Count(r => r.Status == ReservationStatus.Ready)</strong><a href="/reservations">View pickup deadlines →</a></article></div>
    <section class="panel"><div class="section-heading"><h2>On your bookshelf</h2><a class="text-link" href="/loans">All loans →</a></div><LoanTable Loans="loans.Where(l => l.ReturnedAtUtc is null).Take(5).ToList()" /></section>
    <section class="reading-banner"><div><span class="eyebrow">MAKE ROOM FOR SOMETHING NEW</span><h2>Find your next chapter.</h2><p>Request an available book, or join the waiting list when every copy is unavailable.</p></div><a href="/books" class="button primary">Explore books →</a></section>
}
@code {
    private DashboardDto? dashboard;
    private IReadOnlyList<LoanDto> loans = [];
    private IReadOnlyList<ReservationDto> reservations = [];
    private IReadOnlyList<BorrowRequestDto> borrowRequests = [];
    private int PendingRequestCount => borrowRequests.Count(request => request.Status == BorrowRequestStatus.Pending);
    protected override async Task LoadAsync() { if (User.IsLibrarian) dashboard = await Library.GetDashboardAsync(User); loans = await Library.GetLoansAsync(User); borrowRequests = await Library.GetBorrowRequestsAsync(User); if (!User.IsLibrarian) reservations = await Library.GetReservationsAsync(User); }
    private int BarWidth(int count) => dashboard?.PopularBooks.Count > 0 ? Math.Max(3, (int)(100.0 * count / Math.Max(1, dashboard.PopularBooks.Max(b => b.BorrowCount)))) : 0;
}
