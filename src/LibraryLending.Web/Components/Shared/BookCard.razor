<article class="book-card" data-testid="book-card">
    <a class="book-cover-link" href="/books/@Book.Id" aria-label="@Book.Title"><BookCover Book="Book" /></a>
    <div class="book-card-body">
        <span class="eyebrow">@Book.Category</span>
        <h3><a href="/books/@Book.Id">@Book.Title</a></h3>
        <p class="book-author">@Book.Authors</p>
        <div class="book-card-footer">
            <StatusBadge Status="@(Book.AvailableCopies > 0 ? "Available" : "Borrowed")" Label="@(Book.AvailableCopies > 0 ? "Available at library" : "All copies unavailable")" />
            @if (Book.AvailableCopies > 0)
            {
                <a class="button primary book-card-action" href="/books/@Book.Id" aria-label="View book: @Book.Title">View book <Icon Name="arrow-right" /></a>
            }
            else
            {
                <a class="button primary book-card-action" href="/books/@Book.Id#reserve" aria-label="Join waiting list for @Book.Title: view reservation options">Join waiting list <Icon Name="arrow-right" /></a>
            }
        </div>
    </div>
</article>
@code { [Parameter, EditorRequired] public BookDto Book { get; set; } = default!; }
