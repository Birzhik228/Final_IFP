classDiagram
    class Book {
        int Id
        string Title
        string Isbn
        int Year
        string Description
        string CoverUrl
    }
    class BookCopy {
        int Id
        string Barcode
        CopyStatus Status
        string Version
    }
    class Author {
        int Id
        string Name
    }
    class Category {
        int Id
        string Name
    }
    class Member {
        int Id
        string IdentityUserId
        string Name
        MembershipStatus Status
        int BorrowingLimit
        DateTime JoinedAtUtc
    }
    class Loan {
        int Id
        DateTime BorrowedAtUtc
        DateOnly DueDate
        DateTime ReturnedAtUtc
        long DailyFineMinor
        long FinalFineMinor
    }
    class Reservation {
        int Id
        ReservationStatus Status
        DateTime CreatedAtUtc
        DateTime PickupDeadlineUtc
    }
    class BorrowRequest {
        int Id
        int BookId
        int MemberId
        BorrowRequestStatus Status
        DateTime CreatedAtUtc
        DateTime ReviewedAtUtc
        string ReviewerUserId
        string ReviewNote
        int LoanId
        string Version
    }
    class BorrowRequestStatus {
        <<enumeration>>
        Pending
        Accepted
        Rejected
        Cancelled
    }
    class Notification {
        int Id
        string UserId
        string Kind
        string Message
        string DedupeKey
    }
    class LendingRules {
        +DaysOverdue(due, today) int
        +FineMinor(due, end, rate) long
        +CanBorrow(status, limit, active, overdue) Result
        +NextInQueue(reservations) Reservation
    }
    class ILibraryService {
        <<interface>>
        +BorrowAsync(actor, copyId, memberId)
        +ReturnAsync(actor, loanId)
        +ReserveAsync(actor, bookId, memberId)
        +PickupAsync(actor, reservationId)
        +GetBorrowRequestsAsync(actor)
        +RequestBorrowAsync(actor, bookId)
        +AcceptBorrowRequestAsync(actor, requestId)
        +RejectBorrowRequestAsync(actor, requestId, reason)
        +CancelBorrowRequestAsync(actor, requestId)
        +ProcessDeadlinesAsync()
    }
    class LibraryService {
        +RequestBorrowAsync(actor, bookId)
        +AcceptBorrowRequestAsync(actor, requestId)
        +RejectBorrowRequestAsync(actor, requestId, reason)
        +CancelBorrowRequestAsync(actor, requestId)
        -EligibleAsync(session, member)
        -CreateLoanAsync(session, copy, member)
    }
    class ILibraryRepository {
        <<interface>>
        +ExecuteAsync(operation)
        +GetBorrowRequestsAsync(memberId, userId)
    }
    Book "1" --> "0..*" BookCopy : copies
    Book "0..*" --> "1" Category : categorized as
    Book "0..*" -- "0..*" Author : BookAuthor
    BookCopy "1" <-- "0..*" Loan : history
    Member "1" <-- "0..*" Loan : borrows
    Book "1" <-- "0..*" Reservation : queue
    Member "1" <-- "0..*" Reservation : requests
    Reservation "0..*" --> "0..1" BookCopy : assignment history
    Book "1" <-- "0..*" BorrowRequest : available title requests
    Member "1" <-- "0..*" BorrowRequest : submits
    BorrowRequest "0..1" --> "0..1" Loan : acceptance creates
    BorrowRequest --> BorrowRequestStatus : status
    ILibraryService <|.. LibraryService : implements
    LibraryService ..> LendingRules : checks eligibility
    LibraryService ..> ILibraryRepository : uses atomic session
    LibraryService ..> Notification : records outcomes
